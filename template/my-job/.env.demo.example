# ONE env file for this task repo — sits right next to task.md. Copy to .env.demo
# and paste BOTH role keys (the demo pair from the protocol repo's pre-demo
# setup), then:
#   cp .env.demo.example .env.demo
# The MCP reads this file itself for both roles (ORIGINATOR + AGENT) — no keys
# in your editor config. postUpkeep.sh reads ORIGINATOR_PRIVATE_KEY from here
# AND sources this file for its own connection defaults (RPC_URL, CAPITAL_POOL).
# Keys are never output. Arc gas IS USDC; each wallet must hold funds.

ORIGINATOR_PRIVATE_KEY="0x<your-64-hex-demo-originator-private-key>"
AGENT_PRIVATE_KEY="0x<your-64-hex-demo-agent-private-key>"

# The CapitalPool that escrowed tasks settle into (the pool's slices). postUpkeep
# refuses to run without it, so keep this matching the registrar's CAPITAL_POOL.
CAPITAL_POOL="0xB399B1bC57187B307098549e5340a4bFa2bAF3B1"

# Infra defaults — any KEY=VALUE here becomes the MCP server default ONLY when
# the registrar env block leaves it unset (process env always wins). RPC_URL is
# read by signing + reads (and postUpkeep); gas is native USDC on Arc.
RPC_URL="https://rpc.testnet.arc.io"
